{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "进项发票管理",
  "version": "0.1.3",
  "identifier": "com.m241452.tauri-test",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Input Tax",
        "url": "index.html",
        "width": 520,
        "height": 340,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "main",
        "title": "Input Tax",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,

        "center": true,
        "maximized": true,
        "visible": false,
        "decorations": false,
        "resizable": true
      }
    ],

    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ]
  }
}
